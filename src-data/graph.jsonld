      {
        "id": "net-downward-longwave-flux-in-air-assuming-clear-sky",
        "validation-key": "net-downward-longwave-flux-in-air-assuming-clear-sky",
        "ui-label": "Net Downward Longwave Flux In Air Assuming Clear Sky",
        "description": "A phrase assuming_condition indicates that the named quantity is the value which would obtain if all aspects of the system were unaltered except for the assumption of the circumstances specified by the condition. \"longwave\" means longwave radiation. \"Downward\" indicates a vector component which is positive when directed downward (negative upward). Net downward radiation is the difference between radiation from above (downwelling) and radiation from below (upwelling). In accordance with common usage in geophysical disciplines, \"flux\" implies per unit area, called \"flux density\" in physics.",
        "canonical_units": "W m-2",
        "cf-name": "net_downward_longwave_flux_in_air_assuming_clear_sky",
        "type": [
          "wcrp:standard-name",
          "cf"
        ]
      },
      {
        "id": "net-downward-longwave-flux-in-air",
        "validation-key": "net-downward-longwave-flux-in-air",
        "ui-label": "Net Downward Longwave Flux In Air",
        "description": "\"longwave\" means longwave radiation. \"Downward\" indicates a vector component which is positive when directed downward (negative upward). Net downward radiation is the difference between radiation from above (downwelling) and radiation from below (upwelling). In accordance with common usage in geophysical disciplines, \"flux\" implies per unit area, called \"flux density\" in physics.",
        "canonical_units": "W m-2",
        "cf-name": "net_downward_longwave_flux_in_air",
        "type": [
          "wcrp:standard-name",
          "cf"
        ]
      },
      {
        "id": "net-downward-radiative-flux-at-top-of-atmosphere-model",
        "validation-key": "net-downward-radiative-flux-at-top-of-atmosphere-model",
        "ui-label": "Net Downward Radiative Flux At Top Of Atmosphere Model",
        "description": "Fluxes at the top_of_atmosphere_model differ from TOA fluxes only if the model TOA fluxes make some allowance for the atmosphere above the top of the model; if not, it is usual to give standard names with toa to the fluxes at the top of the model atmosphere. \"Downward\" indicates a vector component which is positive when directed downward (negative upward). Net downward radiation is the difference between radiation from above (downwelling) and radiation from below (upwelling). Radiative flux is the sum of shortwave and longwave radiative fluxes. In accordance with common usage in geophysical disciplines, \"flux\" implies per unit area, called \"flux density\" in physics.",
        "canonical_units": "W m-2",
        "cf-name": "net_downward_radiative_flux_at_top_of_atmosphere_model",
        "type": [
          "wcrp:standard-name",
          "cf"
        ]
      },
      {
        "id": "net-downward-shortwave-flux-at-sea-water-surface",
        "validation-key": "net-downward-shortwave-flux-at-sea-water-surface",
        "ui-label": "Net Downward Shortwave Flux At Sea Water Surface",
        "description": "\"Downward\" indicates a vector component which is positive when directed downward (negative upward). Net downward radiation is the difference between radiation from above (downwelling) and radiation from below (upwelling). In accordance with common usage in geophysical disciplines, \"flux\" implies per unit area, called \"flux density\" in physics. The term \"shortwave\" means shortwave radiation. The phrase \"sea water surface\" means the upper boundary of the liquid portion of an ocean or sea, including the boundary to floating ice if present.",
        "canonical_units": "W m-2",
        "cf-name": "net_downward_shortwave_flux_at_sea_water_surface",
        "type": [
          "wcrp:standard-name",
          "cf"
        ]
      },
      {
