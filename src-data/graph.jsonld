      {
        "id": "ocean-salt-mass-transport-across-line",
        "validation-key": "ocean-salt-mass-transport-across-line",
        "ui-label": "Ocean Salt Mass Transport Across Line",
        "description": "Ocean salt mass transport means the mass of salt being transported by all ocean processes. Transport \"across_line\" means that which crosses a particular line on the Earth's surface; formally this means the integral along the line of the normal component of the transport. Positive and negative numbers refer to total northward/eastward and southward/westward transports, respectively.",
        "canonical_units": "kg s-1",
        "cf-name": "ocean_salt_mass_transport_across_line",
        "type": [
          "wcrp:standard-name",
          "cf"
        ]
      },
      {
        "id": "ocean-salt-x-transport",
        "validation-key": "ocean-salt-x-transport",
        "ui-label": "Ocean Salt X Transport",
        "description": "\"x\" indicates a vector component along the grid x-axis, positive with increasing x. Salt transport refers to the mass of salt being transported.",
        "canonical_units": "1e-3 kg s-1",
        "cf-name": "ocean_salt_x_transport",
        "type": [
          "wcrp:standard-name",
          "cf"
        ]
      },
      {
        "id": "ocean-salt-y-transport",
        "validation-key": "ocean-salt-y-transport",
        "ui-label": "Ocean Salt Y Transport",
        "description": "\"y\" indicates a vector component along the grid y-axis, positive with increasing y. Salt transport refers to the mass of salt being transported.",
        "canonical_units": "1e-3 kg s-1",
        "cf-name": "ocean_salt_y_transport",
        "type": [
