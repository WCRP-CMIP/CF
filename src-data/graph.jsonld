      {
        "id": "mass-concentration-of-chlorophyll-a-in-sea-floor-sediment",
        "validation-key": "mass-concentration-of-chlorophyll-a-in-sea-floor-sediment",
        "ui-label": "Mass Concentration Of Chlorophyll A In Sea Floor Sediment",
        "description": "\"Mass concentration\" means mass per unit volume and is used in the construction \"mass_concentration_of_X_in_Y\", where X is a material constituent of Y. A chemical species or biological group denoted by X may be described by a single term such as \"nitrogen\" or a phrase such as \"nox_expressed_as_nitrogen\". Chlorophylls are the green pigments found in most plants, algae and cyanobacteria; their presence is essential for photosynthesis to take place. There are several different forms of chlorophyll that occur naturally. All contain a chlorin ring (chemical formula C20H16N4) which gives the green pigment and a side chain whose structure varies. The naturally occurring forms of chlorophyll contain between 35 and 55 carbon atoms. Chlorophyll-a is the most commonly occurring form of natural chlorophyll. The chemical formula of chlorophyll-a is C55H72O5N4Mg. \"Sea floor sediment\" is sediment deposited at the sea bed.",
        "canonical_units": "kg m-3",
        "cf-name": "mass_concentration_of_chlorophyll_a_in_sea_floor_sediment",
        "type": [
          "wcrp:standard-name",
          "cf"
        ]
      },
      {
        "id": "mass-concentration-of-chlorophyll-a-in-sea-ice",
        "validation-key": "mass-concentration-of-chlorophyll-a-in-sea-ice",
        "ui-label": "Mass Concentration Of Chlorophyll A In Sea Ice",
        "description": "\"Mass concentration\" means mass per unit volume and is used in the construction \"mass_concentration_of_X_in_Y\", where X is a material constituent of Y. A chemical species or biological group denoted by X may be described by a single term such as \"nitrogen\" or a phrase such as \"nox_expressed_as_nitrogen\". Chlorophylls are the green pigments found in most plants, algae and cyanobacteria; their presence is essential for photosynthesis to take place. There are several different forms of chlorophyll that occur naturally. All contain a chlorin ring (chemical formula C20H16N4) which gives the green pigment and a side chain whose structure varies. The naturally occurring forms of chlorophyll contain between 35 and 55 carbon atoms. Chlorophyll-a is the most commonly occurring form of natural chlorophyll. The chemical formula of chlorophyll-a is C55H72O5N4Mg. \"Sea ice\" means all ice floating in the sea which has formed from freezing sea water, rather than by other processes such as calving of land ice to form icebergs.",
        "canonical_units": "kg m-3",
        "cf-name": "mass_concentration_of_chlorophyll_a_in_sea_ice",
        "type": [
          "wcrp:standard-name",
          "cf"
        ]
      },
