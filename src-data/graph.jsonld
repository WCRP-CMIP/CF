        "id": "upward-sea-water-velocity",
        "validation-key": "upward-sea-water-velocity",
        "ui-label": "Upward Sea Water Velocity",
        "description": "A velocity is a vector quantity. \"Upward\" indicates a vector component which is positive when directed upward (negative downward).",
        "canonical_units": "m s-1",
        "cf-name": "upward_sea_water_velocity",
        "type": [
