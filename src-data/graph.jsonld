      {
        "id": "tendency-of-eastward-wind-due-to-eliassen-palm-flux-divergence",
        "validation-key": "tendency-of-eastward-wind-due-to-eliassen-palm-flux-divergence",
        "ui-label": "Tendency Of Eastward Wind Due To Eliassen Palm Flux Divergence",
        "description": "The specification of a physical process by the phrase due_to_process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase. \"Eastward\" indicates a vector component which is positive when directed eastward (negative westward).  \"Eliassen Palm flux\" is a widely used vector in the meridional plane, and the divergence of this flux appears as a forcing in the Transformed Eulerian mean formulation of the zonal mean zonal wind equation.  Thus, \"eastward_wind\" here will generally be the zonally averaged eastward wind.",
        "canonical_units": "m s-2",
        "cf-name": "tendency_of_eastward_wind_due_to_eliassen_palm_flux_divergence",
        "type": [
          "wcrp:standard-name",
          "cf"
        ]
      },
      {
        "id": "tendency-of-eastward-wind-due-to-gravity-wave-drag",
        "validation-key": "tendency-of-eastward-wind-due-to-gravity-wave-drag",
        "ui-label": "Tendency Of Eastward Wind Due To Gravity Wave Drag",
        "description": "The specification of a physical process by the phrase due_to_process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase. \"tendency_of_X\" means derivative of X with respect to time. \"Eastward\" indicates a vector component which is positive when directed eastward (negative westward). Wind is defined as a two-dimensional (horizontal) air velocity vector, with no vertical component. (Vertical motion in the atmosphere has the standard name upward_air_velocity.)  The quantity named tendency_of_eastward_wind_due_to_gravity_wave_drag is the sum of the tendencies due to orographic and nonorographic gravity waves which have standard names of tendency_of_eastward_wind_due_to_orographic_gravity_wave_drag and tendency_of_eastward_wind_due_to_nonorographic_gravity_wave_drag, respectively.",
        "canonical_units": "m s-2",
        "cf-name": "tendency_of_eastward_wind_due_to_gravity_wave_drag",
        "type": [
          "wcrp:standard-name",
          "cf"
        ]
      },
      {
        "id": "tendency-of-eastward-wind-due-to-nonorographic-gravity-wave-drag",
        "validation-key": "tendency-of-eastward-wind-due-to-nonorographic-gravity-wave-drag",
        "ui-label": "Tendency Of Eastward Wind Due To Nonorographic Gravity Wave Drag",
        "description": "The specification of a physical process by the phrase due_to_process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase. \"Eastward\" indicates a vector component which is positive when directed eastward (negative westward).  The total tendency of the eastward wind due to gravity waves has the standard name tendency_of_eastward_wind_due_to_gravity_wave_drag.  It is the sum of the tendencies due to orographic gravity waves and nonorographic waves.  The tendency of eastward wind due to orographic gravity waves has the standard name tendency_of_eastward_wind_due_to_orographic_gravity_wave_drag.",
        "canonical_units": "m s-2",
        "cf-name": "tendency_of_eastward_wind_due_to_nonorographic_gravity_wave_drag",
        "type": [
          "wcrp:standard-name",
          "cf"
        ]
      },
      {
        "id": "tendency-of-eastward-wind-due-to-numerical-artefacts",
        "validation-key": "tendency-of-eastward-wind-due-to-numerical-artefacts",
        "ui-label": "Tendency Of Eastward Wind Due To Numerical Artefacts",
        "description": "The specification of a physical process by the phrase due_to_process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase. \"Eastward\" indicates a vector component which is positive when directed eastward (negative westward).  The total tendency of the eastward wind will include a variety of numerical and diffusive effects: a variable with this standard name is sometimes needed to allow the momentum budget to be closed.",
        "canonical_units": "m s-2",
        "cf-name": "tendency_of_eastward_wind_due_to_numerical_artefacts",
        "type": [
          "wcrp:standard-name",
          "cf"
        ]
      },
      {
        "id": "tendency-of-eastward-wind-due-to-orographic-gravity-wave-drag",
        "validation-key": "tendency-of-eastward-wind-due-to-orographic-gravity-wave-drag",
        "ui-label": "Tendency Of Eastward Wind Due To Orographic Gravity Wave Drag",
        "description": "The specification of a physical process by the phrase due_to_process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase. \"Eastward\" indicates a vector component which is positive when directed eastward (negative westward).  The total tendency of the eastward wind due to gravity waves has the standard name tendency_of_eastward_wind_due_to_gravity_wave_drag.  It is the sum of the tendencies due to orographic gravity waves and nonorographic waves.  The tendency of eastward wind due to nonorographic gravity waves has the standard name tendency_of_eastward_wind_due_to_nonorographic_gravity_wave_drag.",
        "canonical_units": "m s-2",
        "cf-name": "tendency_of_eastward_wind_due_to_orographic_gravity_wave_drag",
