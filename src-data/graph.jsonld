      {
        "id": "tendency-of-sea-ice-amount-due-to-basal-melting",
        "validation-key": "tendency-of-sea-ice-amount-due-to-basal-melting",
        "ui-label": "Tendency Of Sea Ice Amount Due To Basal Melting",
        "description": "The phrase \"tendency_of_X\" means derivative of X with respect to time. \"Amount\" means mass per unit area. \"Sea ice\" means all ice floating in the sea which has formed from freezing sea water, rather than by other processes such as calving of land ice to form icebergs. The specification of a physical process by the phrase due_to_process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase.",
        "canonical_units": "kg m-2 s-1",
        "cf-name": "tendency_of_sea_ice_amount_due_to_basal_melting",
        "type": [
          "wcrp:standard-name",
