        "validation-key": "crops-of-c4-plant-functional-types",
        "ui-label": "Crops Of C4 Plant Functional Types",
        "description": "The definition of \"crops\" is model dependent, for example, some models may include fruit trees as crops. A \"c4 plant\" is one that utilizes the C4 carbon fixation pathway in which the CO2 is first bound to a compound containing four carbon atoms before photosynthesis reactions take place. All trees are C3 type. Grasses and crops can be C3 or C4.",
        "cf-name": "crops_of_c4_plant_functional_types",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "crops",
        "validation-key": "crops",
        "ui-label": "Crops",
        "description": "The definition of \"crops\" is model dependent, for example, some models may include fruit trees as crops.",
        "cf-name": "crops",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "dust-aerosol",
        "validation-key": "dust-aerosol",
        "ui-label": "Dust Aerosol",
        "description": "An area_type of \"dust_aerosol\" indicates that dust aerosol is present at some level in the atmospheric column above an area on the surface of the Earth.",
        "cf-name": "dust_aerosol",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "fire",
        "validation-key": "fire",
        "ui-label": "Fire",
        "description": "An area_type of \"fire\" indicates that biomass fire, either flaming, smouldering, or both, is present.",
        "cf-name": "fire",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "floating-ice-shelf",
        "validation-key": "floating-ice-shelf",
        "ui-label": "Floating Ice Shelf",
        "description": "An area type of \"floating ice shelf\" indicates where ice shelves are present. Ice shelves are the component of ice sheets that flow over the ocean.",
        "cf-name": "floating_ice_shelf",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "floating-ice",
        "validation-key": "floating-ice",
        "ui-label": "Floating Ice",
        "description": "All ice floating on water including lake-ice, sea-ice, ice-shelves and icebergs.",
        "cf-name": "floating_ice",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "fresh-free-water",
        "validation-key": "fresh-free-water",
        "ui-label": "Fresh Free Water",
        "description": "An area type of \"fresh_free_water\" means a free interface between freshwater and the atmosphere without vegetation or other obstructions.",
        "cf-name": "fresh_free_water",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "grounded-ice-sheet",
        "validation-key": "grounded-ice-sheet",
        "ui-label": "Grounded Ice Sheet",
        "description": "An area type of \"grounded ice sheet\" indicates where the ice sheet rest over bedrock and is thus grounded. It excludes ice-caps, glaciers and floating ice shelves.",
        "cf-name": "grounded_ice_sheet",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "herbaceous-vegetation",
        "validation-key": "herbaceous-vegetation",
        "ui-label": "Herbaceous Vegetation",
        "description": "Herbaceous plants are plants with very flexible stems. Their leaves and stems die down to soil level at the end of every growing season. Herbaceous plants can be annual, biennial or perennial.",
        "cf-name": "herbaceous_vegetation",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "ice-and-snow-on-land",
        "validation-key": "ice-and-snow-on-land",
        "ui-label": "Ice And Snow On Land",
        "description": "The area type \"ice_and_snow_on_land\" means ice in glaciers, ice caps, ice sheets (grounded and floating shelves), river and lake ice, any other ice on a land surface, such as frozen flood water, and snow lying on such ice or on the land surface.",
        "cf-name": "ice_and_snow_on_land",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "ice-free-land",
        "validation-key": "ice-free-land",
        "ui-label": "Ice Free Land",
        "description": null,
        "cf-name": "ice_free_land",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "ice-free-sea",
        "validation-key": "ice-free-sea",
        "ui-label": "Ice Free Sea",
        "description": null,
        "cf-name": "ice_free_sea",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "ice-on-land",
        "validation-key": "ice-on-land",
        "ui-label": "Ice On Land",
        "description": "The area type \"ice_on_land\" means ice in glaciers, ice caps, grounded ice sheets (grounded and floating shelves), river and lake ice, and any other ice on a land surface, such as frozen flood water. This is distinct from the area type 'land ice' which has a narrower definition.",
        "cf-name": "ice_on_land",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "ice-sheet",
        "validation-key": "ice-sheet",
        "ui-label": "Ice Sheet",
        "description": "An area type of \"ice_sheet\" indicates where ice sheets are present. It includes both grounded ice sheets resting over bedrock and any ice shelves flowing over the ocean that are attached to grounded ice sheets. The ice_sheet area type excludes ice-caps and glaciers and any floating ice shelves and ice tongues attached to them, but the land_ice area type includes those as well as the ice_sheet area.",
        "cf-name": "ice_sheet",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "lake-and-inland-sea",
        "validation-key": "lake-and-inland-sea",
        "ui-label": "Lake And Inland Sea",
        "description": "The area type lake_and_inland_sea means a quasi-permanent body of water surrounded by land, which may include certain ponds and reservoirs, but excludes rivers and streams which by gravity convey water into and out of lakes or inland seas or into the ocean.",
        "cf-name": "lake_and_inland_sea",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "lake-ice-or-sea-ice",
        "validation-key": "lake-ice-or-sea-ice",
        "ui-label": "Lake Ice Or Sea Ice",
        "description": "Floating ice excluding ice-shelves and icebergs.",
        "cf-name": "lake_ice_or_sea_ice",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "land-ice",
        "validation-key": "land-ice",
        "ui-label": "Land Ice",
        "description": "\"Land ice\" means glaciers, ice-caps, grounded ice sheets resting on bedrock and floating ice-shelves.",
        "cf-name": "land_ice",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "land",
        "validation-key": "land",
        "ui-label": "Land",
        "description": null,
        "cf-name": "land",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "melt-pond-free-sea-ice",
        "validation-key": "melt-pond-free-sea-ice",
        "ui-label": "Melt Pond Free Sea Ice",
        "description": "The area occupied by type \"sea_ice\" is the sum of the areas of types \"sea_ice_melt_pond\" and \"melt_pond_free_sea_ice\".",
        "cf-name": "melt_pond_free_sea_ice",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "natural-grasses-of-c3-plant-functional-types",
        "validation-key": "natural-grasses-of-c3-plant-functional-types",
        "ui-label": "Natural Grasses Of C3 Plant Functional Types",
        "description": "\"Natural grasses\" means grasses growing in areas of low productivity, often situated on rough or uneven ground. This can include rocky areas, briars and heathland. A \"c3 plant\" is one that utilizes the C3 carbon fixation pathway as the sole mechanism to bind CO2 before photosynthesis reactions take place. All trees are C3 type. Grasses and crops can be C3 or C4.",
        "cf-name": "natural_grasses_of_c3_plant_functional_types",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "natural-grasses-of-c4-plant-functional-types",
        "validation-key": "natural-grasses-of-c4-plant-functional-types",
        "ui-label": "Natural Grasses Of C4 Plant Functional Types",
        "description": "\"Natural grasses\" means grasses growing in areas of low productivity, often situated on rough or uneven ground. This can include rocky areas, briars and heathland. A \"c4 plant\" is one that utilizes the C4 carbon fixation pathway in which the CO2 is first bound to a compound containing four carbon atoms before photosynthesis reactions take place. All trees are C3 type. Grasses and crops can be C3 or C4.",
        "cf-name": "natural_grasses_of_c4_plant_functional_types",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "natural-grasses",
        "validation-key": "natural-grasses",
        "ui-label": "Natural Grasses",
        "description": "\"Natural grasses\" means grasses growing in areas of low productivity, often situated on rough or uneven ground. This can include rocky areas, briars and heathland.",
        "cf-name": "natural_grasses",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "needleleaf-deciduous-trees",
        "validation-key": "needleleaf-deciduous-trees",
        "ui-label": "Needleleaf Deciduous Trees",
        "description": "Needleleaf trees, often referred to as conifers, have long, thin needle-shaped leaves that are well adapted to retaining water. Deciduous trees lose their leaves seasonally, for example, during winter in high latitudes or following seasonal variations in rainfall.",
        "cf-name": "needleleaf_deciduous_trees",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "needleleaf-evergreen-trees",
        "validation-key": "needleleaf-evergreen-trees",
        "ui-label": "Needleleaf Evergreen Trees",
        "description": "Needleleaf trees, often referred to as conifers, have long, thin needle-shaped leaves that are well adapted to retaining water. Evergreen plants retain their leaves through the year and into the following growing season (reference: https://www.britannica.com/plant/evergreen-plant).",
        "cf-name": "needleleaf_evergreen_trees",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "pastures-of-c3-plant-functional-types",
        "validation-key": "pastures-of-c3-plant-functional-types",
        "ui-label": "Pastures Of C3 Plant Functional Types",
        "description": "Pastures are assumed to be anthropogenic in origin. They include anthropogenically managed pastureland and rangeland. A \"c3 plant\" is one that utilizes the C3 carbon fixation pathway as the sole mechanism to bind CO2 before photosynthesis reactions take place. All trees are C3 type. Grasses and crops can be C3 or C4.",
        "cf-name": "pastures_of_c3_plant_functional_types",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "pastures-of-c4-plant-functional-types",
        "validation-key": "pastures-of-c4-plant-functional-types",
        "ui-label": "Pastures Of C4 Plant Functional Types",
        "description": "Pastures are assumed to be anthropogenic in origin. They include anthropogenically managed pastureland and rangeland. A \"c4 plant\" is one that utilizes the C4 carbon fixation pathway in which the CO2 is first bound to a compound containing four carbon atoms before photosynthesis reactions take place. All trees are C3 type. Grasses and crops can be C3 or C4.",
        "cf-name": "pastures_of_c4_plant_functional_types",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "pastures",
        "validation-key": "pastures",
        "ui-label": "Pastures",
        "description": "Pastures are assumed to be anthropogenic in origin. They include anthropogenically managed pastureland and rangeland.",
        "cf-name": "pastures",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "permafrost",
        "validation-key": "permafrost",
        "ui-label": "Permafrost",
        "description": "An area type of \"permafrost\" indicates where soil or rock has remained at a temperature at or below zero degrees Celsius throughout the seasonal cycle for two or more years.",
        "cf-name": "permafrost",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "primary-and-secondary-land",
        "validation-key": "primary-and-secondary-land",
        "ui-label": "Primary And Secondary Land",
        "description": "\"Primary and secondary land\" is land that is not in use as crop land or pasture land, including forests, grasslands, bare ground and vegetated wetlands. \"Primary land\" is land that has not undergone lulcc (land use or land cover change) due to human disturbance. \"Secondary land\" is land that has previously been used for agriculture, urban development or logging and has subsequently been abandoned. Reference: Hurtt et al. (2011), Climatic Change, 109 - 117, Harmonization of land-use scenarios for the period 1500–2100: 600 years of global gridded annual land-use transitions, wood harvest, and resulting secondary lands, doi: 10.1007/s10584-011-0153-2. \"Primary and secondary land\" refers to land use or management, rather than to specific categories of vegetation cover, e.g. the primary and secondary succession of plant species.",
        "cf-name": "primary_and_secondary_land",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "primary-deciduous-trees",
        "validation-key": "primary-deciduous-trees",
        "ui-label": "Primary Deciduous Trees",
        "description": "A primary forest is a naturally regenerated forest of native species, where there are no clearly visible indications of human activities and the ecological processes are not significantly disturbed. Reference: 'Global Forest Resources Assessment: Terms and Definitions', Forestry Department of Food and Agriculture Organization (FAO) of the United Nations, Rome 2010, www.fao.org/forestry/14241-0d7b74f45b0d2cfef31599cc17e4c28cd.pdf. Deciduous trees lose their leaves seasonally, for example, during winter in high latitudes or following seasonal variations in rainfall.",
        "cf-name": "primary_deciduous_trees",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "primary-evergreen-trees",
        "validation-key": "primary-evergreen-trees",
        "ui-label": "Primary Evergreen Trees",
        "description": "A primary forest is a naturally regenerated forest of native species, where there are no clearly visible indications of human activities and the ecological processes are not significantly disturbed. Reference: 'Global Forest Resources Assessment: Terms and Definitions', Forestry Department of Food and Agriculture Organization (FAO) of the United Nations, Rome 2010, www.fao.org/forestry/14241-0d7b74f45b0d2cfef31599cc17e4c28cd.pdf. Evergreen trees have leaves in all seasons.",
        "cf-name": "primary_evergreen_trees",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "rain",
        "validation-key": "rain",
        "ui-label": "Rain",
        "description": "An area_type of \"rain\" indicates that falling rain is present at some level in the atmospheric column above an area on the surface of the Earth.",
        "cf-name": "rain",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "river",
        "validation-key": "river",
        "ui-label": "River",
        "description": "The area type river means flowing water in a channel that is mainly driven by gravity. It includes streams, creeks and canals but not lakes or seas. It also includes water in a floodplain.",
        "cf-name": "river",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "sea-ice-melt-pond",
        "validation-key": "sea-ice-melt-pond",
        "ui-label": "Sea Ice Melt Pond",
        "description": "The area classified as type \"sea_ice\" within a grid cell is unaltered when an area of type \"sea_ice_melt_pond\" is also present because melt ponds occur on top of the existing sea ice.",
        "cf-name": "sea_ice_melt_pond",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "sea-ice-ridges",
        "validation-key": "sea-ice-ridges",
        "ui-label": "Sea Ice Ridges",
        "description": "Sea ice \"ridging\" occurs in rough sea conditions. The motion of the sea surface can cause areas of sea ice to deform and fold resulting in ridged upper and lower surfaces. The ridges can be as much as twenty metres thick if thick ice is deformed.",
        "cf-name": "sea_ice_ridges",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "sea-ice",
        "validation-key": "sea-ice",
        "ui-label": "Sea Ice",
        "description": "The area occupied by type \"sea_ice\" within a grid cell is the sum of the areas of types \"sea_ice_melt_pond\" and \"melt_pond_free_sea_ice\". Melt ponds occur on top of the existing sea ice. The area occupied by type \"sea\" is equal to the sum of the areas of types \"ice_free_sea\" and \"sea_ice\".",
        "cf-name": "sea_ice",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "sea",
        "validation-key": "sea",
        "ui-label": "Sea",
        "description": "The area occupied by type \"sea\" is equal to the sum of the areas of types \"ice_free_sea\" and \"sea_ice\".",
        "cf-name": "sea",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "secondary-deciduous-trees",
        "validation-key": "secondary-deciduous-trees",
        "ui-label": "Secondary Deciduous Trees",
        "description": "A secondary forest is a forest that has been logged and has recovered naturally or artificially. Reference: 'Report of the ad hoc technical expert group on forest biological diversity', United Nations Convention on Biological Diversity, www.cbd.int/forest/definitions.shtml. Deciduous trees lose their leaves seasonally, for example, during winter in high latitudes or following seasonal variations in rainfall.",
        "cf-name": "secondary_deciduous_trees",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "secondary-evergreen-trees",
        "validation-key": "secondary-evergreen-trees",
        "ui-label": "Secondary Evergreen Trees",
        "description": "A secondary forest is a forest that has been logged and has recovered naturally or artificially. Reference: 'Report of the ad hoc technical expert group on forest biological diversity', United Nations Convention on Biological Diversity, www.cbd.int/forest/definitions.shtml. Evergreen trees have leaves in all seasons.",
        "cf-name": "secondary_evergreen_trees",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "shrubs",
        "validation-key": "shrubs",
        "ui-label": "Shrubs",
        "description": "The distinction between trees and shrubs is model dependent.",
        "cf-name": "shrubs",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "smoke",
        "validation-key": "smoke",
        "ui-label": "Smoke",
        "description": "An area_type of \"smoke\" indicates that smoke aerosol is present at some level in the atmospheric column above an area on the surface of the Earth.",
        "cf-name": "smoke",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "snow-free-land",
        "validation-key": "snow-free-land",
        "ui-label": "Snow Free Land",
        "description": null,
        "cf-name": "snow_free_land",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "snow",
        "validation-key": "snow",
        "ui-label": "Snow",
        "description": null,
        "cf-name": "snow",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "stratiform-cloud",
        "validation-key": "stratiform-cloud",
        "ui-label": "Stratiform Cloud",
        "description": "This area type complements the \"convective_cloud\" area type, which is the other major category of cloud. The \"cloud\" area type is a more general term and includes both convective_cloud and stratiform_cloud types.",
        "cf-name": "stratiform_cloud",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "trees",
        "validation-key": "trees",
        "ui-label": "Trees",
        "description": "The distinction between trees and shrubs is model dependent. All trees are C3 plant functional type.",
        "cf-name": "trees",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "unfrozen-soil",
        "validation-key": "unfrozen-soil",
        "ui-label": "Unfrozen Soil",
        "description": "An area type of \"unfrozen_soil\" means that the soil at the surface is unfrozen. Frozen soil may be present at lower levels within a soil model.",
        "cf-name": "unfrozen_soil",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "urban",
        "validation-key": "urban",
        "ui-label": "Urban",
        "description": "Urban land is comprised of areas where much of the land is covered by structures. Included in this category are cities, towns and villages. Reference: Anderson, J.R, E. E. Hardy, J. T. Roach and R. E. Witmer (1976), A Land Use And Land Cover Classification System For Use With Remote Sensor Data, Appendix C Land Use Definitions, Geological Survey Professional Paper 964, A revision of the land use classification system as presented in U.S. Geological Survey Circular 671, https://www.usbr.gov/lc/socal/reports/SMappend_C.pdf.",
        "cf-name": "urban",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "vegetation",
        "validation-key": "vegetation",
        "ui-label": "Vegetation",
        "description": null,
        "cf-name": "vegetation",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "volcanic-ash-cloud",
        "validation-key": "volcanic-ash-cloud",
        "ui-label": "Volcanic Ash Cloud",
        "description": "An area_type of \"volcanic_ash_cloud\" indicates that volcanic ash aerosol is present at some level in the atmospheric column above an area on the surface of the Earth.",
        "cf-name": "volcanic_ash_cloud",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      },
      {
        "id": "wetland",
        "validation-key": "wetland",
        "ui-label": "Wetland",
        "description": "Wetlands are areas where water covers the soil, or is present either at or near the surface of the soil all year or for varying periods of time during the year, including during the growing season.",
        "cf-name": "wetland",
        "type": [
          "wcrp:area-type-table",
          "cf"
        ]
      }
    ]
