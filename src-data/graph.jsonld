      {
        "id": "sea-surface-wave-maximum-trough-depth",
        "validation-key": "sea-surface-wave-maximum-trough-depth",
        "ui-label": "Sea Surface Wave Maximum Trough Depth",
        "description": "The trough is the lowest point of a wave. Trough depth is the vertical distance between the trough and the calm sea surface. Maximum trough depth is the maximum value measured during the observation period.",
        "canonical_units": "m",
        "cf-name": "sea_surface_wave_maximum_trough_depth",
        "type": [
