      {
        "id": "surface-partial-pressure-of-carbon-dioxide-abiotic-analogue-in-sea-water",
        "validation-key": "surface-partial-pressure-of-carbon-dioxide-abiotic-analogue-in-sea-water",
        "ui-label": "Surface Partial Pressure Of Carbon Dioxide Abiotic Analogue In Sea Water",
        "description": "The chemical formula for carbon dioxide is CO2. In ocean biogeochemistry models, an \"abiotic analogue\" is used to simulate the effect on a modelled variable when biological effects on ocean carbon concentration and alkalinity are ignored. The partial pressure of a dissolved gas in sea water is the partial pressure in air with which it would be in equilibrium. The partial pressure of a gaseous constituent of air is the pressure that it would exert if all other gaseous constituents were removed, assuming the volume, the temperature, and its number of moles remain unchanged.",
        "canonical_units": "Pa",
        "cf-name": "surface_partial_pressure_of_carbon_dioxide_abiotic_analogue_in_sea_water",
        "type": [
          "wcrp:standard-name",
          "cf"
        ]
      },
      {
        "id": "surface-partial-pressure-of-carbon-dioxide-in-air",
        "validation-key": "surface-partial-pressure-of-carbon-dioxide-in-air",
        "ui-label": "Surface Partial Pressure Of Carbon Dioxide In Air",
        "description": "The surface called \"surface\" means the lower boundary of the atmosphere. The partial pressure of a gaseous constituent of air is the pressure that it would exert if all other gaseous constituents were removed, assuming the volume, the temperature, and its number of moles remain unchanged. The chemical formula for carbon dioxide is CO2.",
        "canonical_units": "Pa",
        "cf-name": "surface_partial_pressure_of_carbon_dioxide_in_air",
        "type": [
          "wcrp:standard-name",
          "cf"
        ]
      },
      {
        "id": "surface-partial-pressure-of-carbon-dioxide-in-sea-water",
        "validation-key": "surface-partial-pressure-of-carbon-dioxide-in-sea-water",
        "ui-label": "Surface Partial Pressure Of Carbon Dioxide In Sea Water",
        "description": "The partial pressure of a dissolved gas in sea water is the partial pressure in air with which it would be in equilibrium. The partial pressure of a gaseous constituent of air is the pressure that it would exert if all other gaseous constituents were removed, assuming the volume, the temperature, and its number of moles remain unchanged. The chemical formula for carbon dioxide is CO2.",
        "canonical_units": "Pa",
        "cf-name": "surface_partial_pressure_of_carbon_dioxide_in_sea_water",
        "type": [
          "wcrp:standard-name",
          "cf"
        ]
      },
      {
        "id": "surface-partial-pressure-of-carbon-dioxide-natural-analogue-in-sea-water",
        "validation-key": "surface-partial-pressure-of-carbon-dioxide-natural-analogue-in-sea-water",
        "ui-label": "Surface Partial Pressure Of Carbon Dioxide Natural Analogue In Sea Water",
        "description": "The chemical formula for carbon dioxide is CO2. In ocean biogeochemistry models, a \"natural analogue\" is used to simulate the effect on a modelled variable of imposing preindustrial atmospheric carbon dioxide concentrations, even when the model as a whole may be subjected to varying forcings. The partial pressure of a dissolved gas in sea water is the partial pressure in air with which it would be in equilibrium. The partial pressure of a gaseous constituent of air is the pressure that it would exert if all other gaseous constituents were removed, assuming the volume, the temperature, and its number of moles remain unchanged.",
        "canonical_units": "Pa",
        "cf-name": "surface_partial_pressure_of_carbon_dioxide_natural_analogue_in_sea_water",
        "type": [
          "wcrp:standard-name",
          "cf"
        ]
      },
