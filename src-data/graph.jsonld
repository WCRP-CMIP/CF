        "ui-label": "Model Level Number At Convective Cloud Top",
        "description": "cloud_top refers to the top of the highest cloud. Model level number should be understood as equivalent to layer number. Convective cloud is that produced by the convection schemes in an atmosphere model.",
        "canonical_units": "1",
        "cf-name": "model_level_number_at_convective_cloud_top",
        "type": [
