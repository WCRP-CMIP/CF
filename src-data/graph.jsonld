      {
        "id": "wood-debris-mass-content-of-carbon",
        "validation-key": "wood-debris-mass-content-of-carbon",
        "ui-label": "Wood Debris Mass Content Of Carbon",
        "description": "\"Content\" indicates a quantity per unit area. \"Wood debris\" means dead organic matter composed of coarse wood. It is distinct from fine litter. The precise distinction between \"fine\" and \"coarse\" is model dependent.",
        "canonical_units": "kg m-2",
        "cf-name": "wood_debris_mass_content_of_carbon",
        "type": [
          "wcrp:standard-name",
          "cf"
        ]
