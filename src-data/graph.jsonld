        "validation-key": "specific-humidity",
        "ui-label": "Specific Humidity",
        "description": "\"specific\" means per unit mass. Specific humidity is the mass fraction of water vapor in (moist) air.",
        "canonical_units": "1",
        "cf-name": "specific_humidity",
        "type": [
          "wcrp:standard-name",
