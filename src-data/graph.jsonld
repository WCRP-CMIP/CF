      {
        "id": "ocean-wet-mass-content-of-epipelagic-micronekton",
        "validation-key": "ocean-wet-mass-content-of-epipelagic-micronekton",
        "ui-label": "Ocean Wet Mass Content Of Epipelagic Micronekton",
        "description": "Component of the micronekton that inhabits permanently the epipelagic layer. The epipelagic layer is the ocean layer with light levels sufficient for photosynthesis. \"Wet_mass\" is the mass of a sample before any water has been removed. \"Content\" indicates a quantity per unit area. The \"ocean content\" of a quantity refers to the vertical integral within the specified vertical bounds. Micronekton is a group of organisms that range in size from 2 to 20 cm and are capable of swimming independently of ocean currents.",
        "canonical_units": "g m-2",
        "cf-name": "ocean_wet_mass_content_of_epipelagic_micronekton",
        "type": [
          "wcrp:standard-name",
          "cf"
        ]
      },
      {
        "id": "ocean-wet-mass-content-of-highly-migrant-lower-mesopelagic-micronekton",
        "validation-key": "ocean-wet-mass-content-of-highly-migrant-lower-mesopelagic-micronekton",
        "ui-label": "Ocean Wet Mass Content Of Highly Migrant Lower Mesopelagic Micronekton",
        "description": "Component of the micronekton that inhabits the lower mesopelagic layer during daytime and the epipelagic layer during nighttime. The lower mesopelagic layer is the lower half of the ocean layer that isn't totally dark but has light levels that are insufficient for photosynthesis. The epipelagic layer is the ocean layer with light levels sufficient for photosynthesis. \"Wet_mass\" is the mass of a sample before any water has been removed. \"Content\" indicates a quantity per unit area. The \"ocean content\" of a quantity refers to the vertical integral within the specified vertical bounds. Micronekton is a group of organisms that range in size from 2 to 20 cm and are capable of swimming independently of ocean currents.",
        "canonical_units": "g m-2",
        "cf-name": "ocean_wet_mass_content_of_highly_migrant_lower_mesopelagic_micronekton",
