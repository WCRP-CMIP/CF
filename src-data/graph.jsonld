        ]
      },
      {
        "id": "sea-surface-wave-maximum-crest-height",
        "validation-key": "sea-surface-wave-maximum-crest-height",
        "ui-label": "Sea Surface Wave Maximum Crest Height",
        "description": "The crest is the highest point of a wave. Crest height is the vertical distance between the crest and the calm sea surface. Maximum crest height is the maximum value measured during the observation period.",
